{
  // HotSpotters: static site plus the copilot agent, all on Cloudflare Workers
  "name": "burn-calendar",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "enable_ctx_exports"],
  // Dynamic Workers: sandboxes that run the short programs the copilot writes for open-ended questions
  "worker_loaders": [{ "binding": "LOADER" }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/agents/*", "/api/*"] },
  // The copilot: one Durable Object per conversation, built on the Cloudflare Agents SDK
  "durable_objects": { "bindings": [{ "name": "FireCopilot", "class_name": "FireCopilot" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FireCopilot"] }],
  "vars": {
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
    "DEEPSEEK_MODEL": "deepseek-flash",
    // Voice: OpenAI Realtime speech-to-speech; answers come from the copilot above
    "OPENAI_REALTIME_MODEL": "gpt-realtime",
    "OPENAI_REALTIME_VOICE": "marin",
    // Place-name lookup for places that are not a country, state or district (rules: config/geocoder.json)
    "GEOCODER_URL": "https://nominatim.openstreetmap.org/search",
    "GEOCODER_USER_AGENT": "HotSpotters/0.1 (NASA Space Apps hackathon prototype)"
  },
  "routes": [
    { "pattern": "hotspotters.compare", "custom_domain": true },
    { "pattern": "www.hotspotters.compare", "custom_domain": true }
  ]
}
